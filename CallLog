
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>UHC Call Log</title>
<style>
*{box-sizing:border-box}
[hidden]{display:none!important}
body{margin:0;background:#101820;color:#eef5f8;font:13px Arial,sans-serif}
main{max-width:1450px;margin:auto;padding:12px}
header,.buttons{display:flex;justify-content:space-between;align-items:center;gap:8px}
h1{font-size:21px;margin:0}h3{font-size:13px;margin:0 0 9px}
section{background:#1c2836;border:1px solid #394a59;border-radius:9px;padding:11px;margin-top:9px}
.two,.three,.notes{display:grid;gap:9px}
.two,.notes{grid-template-columns:repeat(2,minmax(0,1fr))}
.three{grid-template-columns:repeat(3,minmax(0,1fr))}
label{display:block;color:#c0ced9;font-size:12px}
input:not([type=checkbox]),select,textarea{display:block;width:100%;margin-top:4px;background:#101b28;color:white;border:1px solid #506171;border-radius:5px;padding:7px;font:inherit}
input:not([type=checkbox]),select{height:32px}
textarea{height:79px;resize:vertical}
.options{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px;margin-top:9px}
.options label,.checks label{display:flex;align-items:center;gap:6px;color:white}
.options label{background:#263647;border:1px solid #405568;border-radius:6px;padding:8px}
input[type=checkbox]{width:15px;height:15px;margin:0;accent-color:#77c9bc}
.checks{display:flex;gap:15px;flex-wrap:wrap;margin:9px 0}
button{background:#263647;color:white;border:1px solid #526576;border-radius:6px;padding:9px 12px;cursor:pointer}
button.primary{background:#77c9bc;color:#122329;font-weight:bold}
nav{display:flex;gap:7px;margin-top:10px}
#output{height:130px;margin-top:10px}
#msg{color:#77c9bc}
@media(max-width:850px){.two,.three{grid-template-columns:1fr 1fr}}
</style>
</head>
<body>
<main>
<header><h1>UHC Call Log</h1><span id="date"></span></header>
<nav><button onclick="view('call')">Call Log</button><button onclick="view('update')">Follow Up Update</button></nav>
<div id="call">
<section class="three">
  <div id="interaction"></div>
  <label>Caller Type<select id="caller" onchange="showFields()"><option>Member</option><option>Broker</option><option>Auxiliary Contact</option></select></label>
  <div id="memberId"></div>
</section>
<div class="two">
<div>
<section>
<h3>Caller &amp; Member</h3>
<div class="two" id="member"></div>
<div class="checks"><label><input type="checkbox" id="ivr">IVR Verified</label><label><input type="checkbox" id="hipaa">HIPAA Verified</label></div>
<div class="two" id="broker" hidden></div>
<div id="ac" hidden><div class="two" id="acFields"></div><div class="checks"><label><input type="checkbox" id="consent">Verbal Consent</label></div></div>
</section>
<section>
<div class="buttons"><h3>Provider Information</h3><label><input type="checkbox" id="hasProvider" onchange="showFields()"> Provider involved</label></div>
<div id="provider" hidden><div class="three" id="providerFields"></div></div>
</section>
</div>
<div>
<section>
<h3>Call Type</h3>
<div class="options" id="types"></div>
<div id="other" hidden></div>
</section>
<section>
<h3>Status</h3>
<div class="options" id="statuses"></div>
<div id="statusDetails" class="two"><div id="followDetail" hidden></div><div id="escalateDetail" hidden></div></div>
</section>
</div>
</div>
<section><h3>Call Documentation</h3><div class="notes" id="notes"></div></section>
<div class="buttons" style="margin-top:10px">
<span id="msg"></span>
<div><button onclick="newCall()">New Call</button> <button onclick="view('update')">Follow Up Update</button> <button class="primary" onclick="copy(makeNote())">Copy for OneNote</button></div>
</div>
</div>
<div id="update" hidden>
<section>
<h3>Follow Up Update</h3>
<label>Previous OneNote log (paste here if returning another day)<textarea id="previous" placeholder="Optional when continuing the current call"></textarea></label>
<div class="two" style="margin-top:9px">
<label>Outcome<select id="outcome"><option>Reached member</option><option>Reached broker</option><option>Reached auxiliary contact</option><option>Left voicemail</option><option>Unable to reach</option><option>Other</option></select></label>
<label>Current Status<select id="newStatus"><option>Resolved</option><option>Follow Up</option><option>Escalated</option></select></label>
</div>
<div class="notes" id="updateFields" style="margin-top:9px"></div>
</section>
<div class="buttons" style="margin-top:10px"><span>Update time: <span id="updateDate"></span></span><div><button onclick="view('call')">Back</button> <button class="primary" onclick="copyUpdate()">Copy Updated Log</button></div></div>
</div>
<textarea id="output" readonly hidden></textarea>
</main>
<script>
const $=id=>document.getElementById(id);
const now=()=>new Date().toLocaleString('en-US',{dateStyle:'medium',timeStyle:'short'});
let started=now(),updated='',original='';
function fields(id,names,area=false){$(id).innerHTML=names.split('|').map(n=>`<label>${n}${area?`<textarea data-key="${n}"></textarea>`:`<input data-key="${n}">`}</label>`).join('')}
function choices(id,names){$(id).innerHTML=names.split('|').map(n=>`<label><input type="checkbox" value="${n}" onchange="showFields()">${n}</label>`).join('')}
function val(n){return document.querySelector(`[data-key="${n}"]`)?.value.trim()||''}
function selected(id){return [...$(id).querySelectorAll('input:checked')].map(x=>x.value)}
function on(id){return $(id).checked?'Yes':'No'}
function showFields(){
 $('broker').hidden=$('caller').value!=='Broker';
 $('ac').hidden=$('caller').value!=='Auxiliary Contact';
 $('provider').hidden=!$('hasProvider').checked;
 $('other').hidden=!selected('types').includes('Other');
 $('followDetail').hidden=!selected('statuses').includes('Follow Up');
 $('escalateDetail').hidden=!selected('statuses').includes('Escalated');
}
fields('interaction','Interaction ID');fields('memberId','Member ID');
fields('member','Member Name|Member Phone');
fields('broker','Broker Name|Broker ID');fields('acFields','AC Name|AC Phone');
fields('providerFields','Provider Name|Provider Type|Provider ID / NPI|Provider Phone|Provider Address');
fields('other','Other Call Type');
fields('followDetail','Follow Up Details');fields('escalateDetail','Escalation Details');
fields('notes','Issue|Research|Resolution|Follow Up|Personal Notes',true);
fields('updateFields','Reason For Follow Up|Actions Taken|Final Resolution|Remaining Steps',true);
choices('types','Claims|Benefits|Prior Authorization|Provider Search|Pharmacy|Escalation|Other');
choices('statuses','Resolved|Follow Up|Escalated');
function add(lines,k,v){lines.push(k+': '+(v||'-'))}
function makeNote(){
 let lines=[],s=selected('statuses'),t=selected('types').map(x=>x==='Other'&&val('Other Call Type')?'Other: '+val('Other Call Type'):x);
 add(lines,'PAGE TITLE',started+' - '+(val('Member Name')||$('caller').value)+' - '+val('Interaction ID'));
 add(lines,'Call Date/Time',started);add(lines,'Interaction ID',val('Interaction ID'));
 add(lines,'Caller Type',$('caller').value);add(lines,'Member ID',val('Member ID'));
 add(lines,'Member Name',val('Member Name'));add(lines,'Member Phone',val('Member Phone'));
 add(lines,'IVR Verified',on('ivr'));add(lines,'HIPAA Verified',on('hipaa'));
 if($('caller').value==='Broker')for(let k of ['Broker Name','Broker ID'])add(lines,k,val(k));
 if($('caller').value==='Auxiliary Contact'){
  for(let k of ['AC Name','AC Phone'])add(lines,k,val(k));add(lines,'Verbal Consent',on('consent'));
 }
 if($('hasProvider').checked)for(let k of ['Provider Name','Provider Type','Provider ID / NPI','Provider Phone','Provider Address'])add(lines,k,val(k));
 add(lines,'Call Type',t.join(', '));add(lines,'Status',s.join(', '));add(lines,'Tags',s.includes('Follow Up')?'#FollowUp':'');
 if(s.includes('Follow Up'))add(lines,'Follow Up Details',val('Follow Up Details'));
 if(s.includes('Escalated'))add(lines,'Escalation Details',val('Escalation Details'));
 for(let k of ['Issue','Research','Resolution','Follow Up','Personal Notes'])add(lines,k,val(k));
 return lines.join('\n');
}
function view(name){
 $('call').hidden=name!=='call';$('update').hidden=name!=='update';$('output').hidden=true;
 if(name==='update'){
  if(!updated){updated=now();original=makeNote()}
  $('updateDate').textContent=updated;
  if(!val('Reason For Follow Up'))document.querySelector('[data-key="Reason For Follow Up"]').value=val('Follow Up Details')||val('Issue');
 }
}
function copy(text){
 $('output').hidden=false;$('output').value=text;$('output').focus();$('output').select();
 let ok=false;try{ok=document.execCommand('copy')}catch(e){}
 $('msg').textContent=ok?'Copied. Paste in OneNote.':'Press Ctrl+C to copy the selected text.';
 if(ok)$('output').hidden=true;
}
function copyUpdate(){
 let status=$('newStatus').value;
 if(status==='Resolved'&&!val('Final Resolution')){alert('Enter the final resolution first.');return}
 let text=$('previous').value.trim()||original;
 text=text.replace(/^Status:.*$/m,'Status: '+status).replace(/^Tags:.*$/m,'Tags: '+(status==='Follow Up'?'#FollowUp':''));
 text+='\n\nFOLLOW UP UPDATE - '+updated+'\n';
 text+='Outcome: '+$('outcome').value+'\n';
 for(let k of ['Reason For Follow Up','Actions Taken','Final Resolution','Remaining Steps'])text+=k+': '+(val(k)||'-')+'\n';
 text+='Updated Status: '+status;
 if(!$('previous').value.trim()){
  $('statuses').querySelectorAll('input').forEach(x=>x.checked=x.value===status);
  showFields();
 }
 copy(text);
}
function newCall(){
 if(!confirm('Clear the current call?'))return;
 document.querySelectorAll('input,textarea').forEach(x=>{if(x.type==='checkbox')x.checked=false;else x.value=''});
 $('caller').value='Member';$('outcome').selectedIndex=0;$('newStatus').value='Resolved';
 started=now();updated='';original='';$('date').textContent=started;$('msg').textContent='';showFields();view('call');
}
$('date').textContent=started;showFields();
</script>
</body>
</html>
