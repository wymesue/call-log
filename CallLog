<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>UHC Call Log</title>
<style>
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  body { margin: 0; background: #101820; color: #eef5f8; font: 14px Arial, sans-serif; line-height: 1.4; }
  main { max-width: 1400px; margin: auto; padding: 20px; }
  header, .buttons, .section-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  h1 { font-size: 23px; margin: 0; }
  h2 { font-size: 15px; margin: 0 0 14px; }
  .muted { color: #a9becb; font-size: 12px; }
  section { background: #1c2836; border: 1px solid #394a59; border-radius: 10px; padding: 18px; margin-top: 14px; }
  .section-head h2 { margin-bottom: 0; }
  .two, .three, .notes { display: grid; gap: 14px; }
  .two, .notes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  label { display: block; color: #c6d4de; font-size: 12px; }
  input:not([type=checkbox]), select, textarea {
    display: block; width: 100%; margin-top: 6px; padding: 9px;
    background: #101b28; color: white; border: 1px solid #506171;
    border-radius: 6px; font: 14px Arial, sans-serif;
  }
  input:not([type=checkbox]), select { height: 37px; }
  textarea { height: 106px; resize: vertical; }
  .options { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin-top: 12px; }
  .options label, .checks label, .section-head label {
    display: flex; align-items: center; gap: 7px; color: white;
  }
  .options label { padding: 12px; background: #263647; border: 1px solid #405568; border-radius: 7px; }
  input[type=checkbox] { width: 16px; height: 16px; margin: 0; flex-shrink: 0; accent-color: #77c9bc; }
  .checks { display: flex; gap: 18px; flex-wrap: wrap; margin-top: 14px; }
  .details { margin-top: 12px; }
  .notes label:last-child { grid-column: 1 / -1; }
  button { padding: 10px 14px; background: #263647; color: white; border: 1px solid #526576; border-radius: 6px; cursor: pointer; }
  button.primary { background: #77c9bc; color: #122329; border-color: #77c9bc; font-weight: bold; }
  nav { display: flex; gap: 8px; margin: 14px 0 2px; }
  nav button.active { border-color: #77c9bc; color: #77c9bc; }
  .buttons { margin-top: 14px; flex-wrap: wrap; }
  .buttons > div { display: flex; flex-wrap: wrap; gap: 8px; }
  #msg { color: #77c9bc; font-size: 12px; }
  #preview { background: #152330; color: #eef5f8; padding: 28px; border: 1px solid #394a59; border-radius: 8px; margin-top: 12px; }
  #output { width: 100%; min-height: 130px; }
  @media (max-width: 850px) {
    .two, .three, .notes { grid-template-columns: 1fr; }
    .notes label:last-child { grid-column: auto; }
    .options { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
</head>
<body>
<main>
  <header>
    <h1>UHC Call Log</h1>
    <span class="muted" id="date"></span>
  </header>
  <nav>
    <button id="tabCall" class="active" onclick="view('call')">Call Log</button>
    <button id="tabUpdate" onclick="view('update')">Follow Up Update</button>
  </nav>

  <div id="call">
    <section class="three">
      <div id="interaction"></div>
      <label>Caller Type
        <select id="caller" onchange="showFields()">
          <option>Member</option><option>Broker</option><option>Auxiliary Contact</option>
        </select>
      </label>
      <div id="memberId"></div>
    </section>

    <div class="two">
      <div>
        <section>
          <h2>Caller &amp; Member Information</h2>
          <div class="two" id="member"></div>
          <div class="checks">
            <label><input type="checkbox" id="ivr"> IVR Verified</label>
            <label><input type="checkbox" id="hipaa"> HIPAA Verified</label>
          </div>
          <div class="two details" id="broker" hidden></div>
          <div id="ac" hidden>
            <div class="two details" id="acFields"></div>
            <div class="checks"><label><input type="checkbox" id="consent"> Verbal Consent</label></div>
          </div>
        </section>
        <section>
          <div class="section-head">
            <h2>Provider Information</h2>
            <label><input type="checkbox" id="hasProvider" onchange="showFields()"> Provider involved</label>
          </div>
          <div id="provider" class="details" hidden><div class="three" id="providerFields"></div></div>
        </section>
      </div>
      <div>
        <section>
          <h2>Call Type</h2>
          <div class="options" id="types"></div>
          <div class="details" id="other" hidden></div>
        </section>
        <section>
          <h2>Status</h2>
          <div class="options" id="statuses"></div>
          <div class="two details" id="statusDetails">
            <div id="followDetail" hidden></div>
            <div id="escalateDetail" hidden></div>
          </div>
        </section>
      </div>
    </div>

    <section>
      <h2>Call Documentation</h2>
      <div class="notes" id="notes"></div>
    </section>
    <div class="buttons">
      <span id="msg" role="status"></span>
      <div>
        <button onclick="newCall()">New Call</button>
        <button onclick="view('update')">Follow Up Update</button>
        <button onclick="showPreview()">Preview OneNote</button>
        <button class="primary" onclick="copyNote(makeNote())">Copy for OneNote</button>
      </div>
    </div>
  </div>

  <div id="update" hidden>
    <section>
      <h2>Follow Up Update</h2>
      <label>Previous OneNote log (paste here if returning on another day)
        <textarea id="previous" placeholder="Leave blank if continuing a call in this window"></textarea>
      </label>
      <div class="two details">
        <label>Outcome
          <select id="outcome">
            <option>Reached member</option><option>Reached broker</option>
            <option>Reached auxiliary contact</option><option>Left voicemail</option>
            <option>Unable to reach</option><option>Other</option>
          </select>
        </label>
        <label>Current Status
          <select id="newStatus">
            <option>Resolved</option><option>Follow Up</option><option>Escalated</option>
          </select>
        </label>
      </div>
      <div class="notes details" id="updateFields"></div>
    </section>
    <div class="buttons">
      <span class="muted">Update recorded: <span id="updateDate"></span></span>
      <div>
        <button onclick="view('call')">Back to Call</button>
        <button onclick="showPreview(true)">Preview OneNote</button>
        <button class="primary" onclick="copyUpdate()">Copy Updated Log</button>
      </div>
    </div>
  </div>

  <section id="previewSection" hidden>
    <div class="section-head">
      <h2>OneNote Preview — colors and layout intended for pasting</h2>
      <button onclick="$('previewSection').hidden=true">Close Preview</button>
    </div>
    <div id="preview"></div>
  </section>
  <textarea id="output" readonly hidden aria-label="Selected call log text"></textarea>
</main>
<script>
  const $ = id => document.getElementById(id);
  const startedFormat = d => d.toLocaleDateString('en-GB', {day:'numeric',month:'long',year:'numeric'});
  const timeFormat = d => d.toLocaleTimeString('en-US', {hour:'numeric',minute:'2-digit'});
  let started = new Date(), updated = null, original = '';

  function fields(id, names, area=false) {
    $(id).innerHTML = names.split('|').map(name =>
      `<label>${name}${area ? `<textarea data-key="${name}"></textarea>` : `<input data-key="${name}">`}</label>`
    ).join('');
  }
  function choices(id, names) {
    $(id).innerHTML = names.split('|').map(name =>
      `<label><input type="checkbox" value="${name}" onchange="showFields()">${name}</label>`
    ).join('');
  }
  function val(name) {
    return document.querySelector(`[data-key="${name}"]`)?.value.trim() || '';
  }
  function selected(id) {
    return [...$(id).querySelectorAll('input:checked')].map(item => item.value);
  }
  function on(id) { return $(id).checked ? 'Yes' : 'No'; }
  function showFields() {
    $('broker').hidden = $('caller').value !== 'Broker';
    $('ac').hidden = $('caller').value !== 'Auxiliary Contact';
    $('provider').hidden = !$('hasProvider').checked;
    $('other').hidden = !selected('types').includes('Other');
    $('followDetail').hidden = !selected('statuses').includes('Follow Up');
    $('escalateDetail').hidden = !selected('statuses').includes('Escalated');
  }

  fields('interaction','Interaction ID');
  fields('memberId','Member ID');
  fields('member','Member Name|Member Phone');
  fields('broker','Broker Name|Broker ID');
  fields('acFields','AC Name|AC Phone');
  fields('providerFields','Provider Name|Provider Type|Provider ID / NPI|Provider Phone|Provider Address');
  fields('other','Other Call Type');
  fields('followDetail','Follow Up Details');
  fields('escalateDetail','Escalation Details');
  fields('notes','Issue|Research|Resolution|Follow Up|Personal Notes',true);
  fields('updateFields','Reason For Follow Up|Actions Taken|Final Resolution|Remaining Steps',true);
  choices('types','Claims|Benefits|Prior Authorization|Provider Search|Pharmacy|Escalation|Other');
  choices('statuses','Resolved|Follow Up|Escalated');

  // The first line is the suggested OneNote page title: date + Member ID, no time.
  function makeNote() {
    const types = selected('types').map(type =>
      type === 'Other' && val('Other Call Type') ? 'Other: ' + val('Other Call Type') : type
    );
    const statuses = selected('statuses');
    const lines = [startedFormat(started) + ' - ' + (val('Member ID') || 'No Member ID')];
    const line = (name, value) => lines.push(name + ': ' + (value || '-'));
    const section = title => lines.push('', title.toUpperCase());

    section('Call Information');
    line('Call Time',timeFormat(started));
    line('Interaction ID',val('Interaction ID'));
    line('Caller Type',$('caller').value);
    line('Member ID',val('Member ID'));
    line('Member Name',val('Member Name'));
    line('Member Phone',val('Member Phone'));
    line('IVR Verified',on('ivr'));
    line('HIPAA Verified',on('hipaa'));
    if ($('caller').value === 'Broker') {
      for (const name of ['Broker Name','Broker ID']) line(name,val(name));
    }
    if ($('caller').value === 'Auxiliary Contact') {
      for (const name of ['AC Name','AC Phone']) line(name,val(name));
      line('Verbal Consent',on('consent'));
    }
    if ($('hasProvider').checked) {
      section('Provider Information');
      for (const name of ['Provider Name','Provider Type','Provider ID / NPI','Provider Phone','Provider Address']) line(name,val(name));
    }

    section('Call Type & Status');
    line('Call Type',types.join(', '));
    line('Status',statuses.join(', '));
    if (statuses.includes('Follow Up')) line('Tags','#FollowUp');
    if (statuses.includes('Follow Up')) line('Follow Up Details',val('Follow Up Details'));
    if (statuses.includes('Escalated')) line('Escalation Details',val('Escalation Details'));

    section('Call Documentation');
    for (const name of ['Issue','Research','Resolution','Follow Up','Personal Notes']) {
      lines.push('', name.toUpperCase(), val(name) || '-');
    }
    return lines.join('\n');
  }

  function view(name) {
    $('call').hidden = name !== 'call';
    $('update').hidden = name !== 'update';
    $('tabCall').classList.toggle('active',name === 'call');
    $('tabUpdate').classList.toggle('active',name === 'update');
    $('previewSection').hidden = true;
    if (name === 'update') {
      if (!updated) {
        updated = new Date();
        original = makeNote();
      }
      $('updateDate').textContent = startedFormat(updated) + ', ' + timeFormat(updated);
      if (!val('Reason For Follow Up')) {
        document.querySelector('[data-key="Reason For Follow Up"]').value =
          val('Follow Up Details') || val('Issue');
      }
    }
  }

  function makeUpdate() {
    const status = $('newStatus').value;
    if (status === 'Resolved' && !val('Final Resolution')) {
      alert('Enter the final resolution first.');
      return null;
    }
    const source = $('previous').value.trim() || original || makeNote();
    let text = source
      .replace(/^Status:.*$/m,'Status: ' + status)
      .replace(/^Tags:.*\n?/gm,'');
    if (status === 'Follow Up') text = text.replace(/^Status:.*$/m, '$&\nTags: #FollowUp');
    const lines = [
      '',
      'FOLLOW UP UPDATE - ' + startedFormat(updated) + ', ' + timeFormat(updated),
      'Outcome: ' + $('outcome').value,
      'Current Status: ' + status
    ];
    for (const name of ['Reason For Follow Up','Actions Taken','Final Resolution','Remaining Steps']) {
      lines.push('', name.toUpperCase(), val(name) || '-');
    }
    return text.trimEnd() + '\n' + lines.join('\n');
  }

  // Copy actual HTML formatting as well as plain text for OneNote.
  function escapeHtml(value) {
    return value.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }
  const sectionHeadings = new Set([
    'CALL INFORMATION', 'PROVIDER INFORMATION', 'CALL TYPE & STATUS', 'CALL DOCUMENTATION'
  ]);
  const noteHeadings = new Set([
    'ISSUE', 'RESEARCH', 'RESOLUTION', 'FOLLOW UP', 'PERSONAL NOTES',
    'REASON FOR FOLLOW UP', 'ACTIONS TAKEN', 'FINAL RESOLUTION', 'REMAINING STEPS'
  ]);
  function richHtml(text) {
    const lines = text.replace(/\r/g,'').split('\n');
    const parts = ['<div style="font:11pt Calibri,Arial,sans-serif;line-height:1.5;background-color:transparent">'];
    lines.forEach((line, index) => {
      const clean = line.trim();
      const safe = escapeHtml(line);
      if (index === 0) {
        parts.push(`<h1 style="font-size:19pt;color:#8bdfe9;border-bottom:3px solid #3fa3b0;padding-bottom:10px;margin:0 0 14px">${safe}</h1>`);
      } else if (!clean) {
        parts.push('<div style="height:8px"></div>');
      } else if (clean.startsWith('FOLLOW UP UPDATE - ')) {
        parts.push(`<h2 style="color:#f6c977;border-left:4px solid #e9b955;padding:9px 12px;font-size:13pt;margin:20px 0 10px">${safe}</h2>`);
      } else if (sectionHeadings.has(clean)) {
        parts.push(`<h2 style="color:#77d5e2;border-left:4px solid #3fa3b0;padding:9px 12px;font-size:12pt;margin:17px 0 10px">${safe}</h2>`);
      } else if (noteHeadings.has(clean)) {
        parts.push(`<h3 style="color:#8bdfe9;font-size:11pt;font-weight:bold;margin:13px 0 5px">${safe}</h3>`);
      } else if (/^(Status|Current Status|Updated Status): /.test(clean)) {
        const divider = line.indexOf(': ');
        const key = escapeHtml(line.slice(0,divider));
        const labels = line.slice(divider+2).split(',').map(x=>x.trim()).filter(Boolean);
        const badges = labels.map(label => {
          const color = label === 'Resolved' ? '#61e0a2' :
            label === 'Follow Up' ? '#f6c977' :
            label === 'Escalated' ? '#ff9595' : '#c7dbe5';
          return `<span style="display:inline-block;color:${color};border:1px solid currentColor;border-radius:4px;padding:3px 8px;margin:2px 5px 2px 0;font-weight:bold">${escapeHtml(label)}</span>`;
        }).join('');
        parts.push(`<p style="margin:6px 0"><strong style="color:#8bdfe9">${key}:</strong> ${badges}</p>`);
      } else if (clean.startsWith('Tags: ')) {
        parts.push(`<p style="margin:6px 0"><strong style="color:#8bdfe9">Tags:</strong> <span style="color:#f6c977;font-weight:bold;padding:3px 8px">${escapeHtml(line.slice(6))}</span></p>`);
      } else if (/^[A-Za-z][A-Za-z /]+: /.test(line)) {
        const divider = line.indexOf(': ');
        const key = escapeHtml(line.slice(0,divider));
        const value = escapeHtml(line.slice(divider+2));
        parts.push(`<p style="margin:5px 0;padding:2px 0"><strong style="color:#8bdfe9">${key}:</strong> ${value}</p>`);
      } else {
        parts.push(`<p style="margin:5px 0;white-space:pre-wrap">${safe}</p>`);
      }
    });
    parts.push('</div>');
    return parts.join('');
  }

  function showPreview(isUpdate=false) {
    const text = isUpdate ? makeUpdate() : makeNote();
    if (text === null) return;
    $('preview').innerHTML = richHtml(text);
    $('previewSection').hidden = false;
    $('previewSection').scrollIntoView({block:'nearest',behavior:'smooth'});
  }
  async function copyNote(text) {
    if (text === null) return;
    const html = richHtml(text);
    let copied = false;
    // Supplying clean HTML directly avoids copying the browser page's background.
    if (navigator.clipboard && window.ClipboardItem) {
      try {
        await navigator.clipboard.write([new ClipboardItem({
          'text/html': new Blob([html], {type:'text/html'}),
          'text/plain': new Blob([text], {type:'text/plain'})
        })]);
        copied = true;
      } catch (error) { /* clipboard access may be blocked in Citrix */ }
    }
    if (!copied) {
      const temporary = document.createElement('div');
      temporary.contentEditable = 'true';
      temporary.style.cssText = 'position:fixed;left:-10000px;top:0;background:transparent';
      temporary.innerHTML = html;
      document.body.appendChild(temporary);
      const selection = window.getSelection();
      const range = document.createRange();
      range.selectNodeContents(temporary);
      selection.removeAllRanges();
      selection.addRange(range);
      try { copied = document.execCommand('copy'); } catch (error) { /* fallback below */ }
      selection.removeAllRanges();
      temporary.remove();
    }
    if (!copied) {
      $('output').hidden = false;
      $('output').value = text;
      $('output').focus();
      $('output').select();
      $('msg').textContent = 'Press Ctrl+C to copy plain text (no white boxes).';
    } else {
      $('output').hidden = true;
      $('msg').textContent = 'Copied. Paste into OneNote using Ctrl+V.';
    }
  }
  function copyUpdate() {
    const text = makeUpdate();
    if (text === null) return;
    const status = $('newStatus').value;
    if (!$('previous').value.trim()) {
      $('statuses').querySelectorAll('input').forEach(item => item.checked = item.value === status);
      showFields();
    }
    copyNote(text);
  }
  function newCall() {
    if (!confirm('Clear the current call?')) return;
    document.querySelectorAll('input,textarea').forEach(item => {
      if (item.type === 'checkbox') item.checked = false;
      else item.value = '';
    });
    $('caller').value = 'Member';
    $('outcome').selectedIndex = 0;
    $('newStatus').value = 'Resolved';
    started = new Date();
    updated = null;
    original = '';
    $('date').textContent = startedFormat(started) + ' · ' + timeFormat(started);
    $('msg').textContent = '';
    showFields();
    view('call');
  }
  $('date').textContent = startedFormat(started) + ' · ' + timeFormat(started);
  showFields();
</script>
</body>
</html>
